#!/bin/sh
# Create the skeleton of a new trail under content/trails/.
#
#   new-trail [-a] <slug>
#
#   -a   with-assets form: content/trails/<slug>/index.smd

set -e

usage() {
	echo "usage: new-trail [-a] <slug>" >&2
	exit 2
}

assets=
while getopts a opt; do
	case $opt in
	a) assets=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage
slug=$1

case $slug in
index) echo "new-trail: 'index' is the trails index page" >&2; exit 2 ;;
*[!a-z0-9-]* | -* | *- | "") echo "new-trail: bad slug: $slug" >&2; exit 2 ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
dir=$root/content/trails

if [ -n "$assets" ]; then
	target=$dir/$slug/index.smd
	other=$dir/$slug.smd
else
	target=$dir/$slug.smd
	other=$dir/$slug/index.smd
fi

for f in "$target" "$other"; do
	if [ -e "$f" ]; then
		echo "new-trail: already exists: $f" >&2
		exit 1
	fi
done

# Title-case the slug: "legal-epidemiology" -> "Legal Epidemiology".
title=
for word in $(echo "$slug" | tr - ' '); do
	rest=${word#?}
	first=${word%"$rest"}
	title="$title $(echo "$first" | tr a-z A-Z)$rest"
done
title=${title# }

[ -n "$assets" ] && mkdir -p "$dir/$slug"

cat >"$target" <<EOF
---
.title = "$title",
.date = .date("$(date +%Y-%m-%dT00:00:00)"),
.description = "",
.layout = "post.shtml",
---

EOF

echo "$target"
